PORT=5000
CLIENT_URL=http://localhost:5173
JARVIS_DESKTOP_AGENT_PORT=8766

# Choose: gemini | groq | openrouter
AI_PROVIDER=gemini

# Add the matching key in your real .env file.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=openai/gpt-4o-mini
JARVIS_LOCAL_AI_URL=http://127.0.0.1:8765
JARVIS_DESKTOP_AGENT_URL=http://127.0.0.1:8766