{
  "name": "jarvis-desktop-assistant",
  "private": true,
  "scripts": {
    "dev": "bash -c 'trap \"kill 0\" EXIT INT TERM; npm --prefix server run dev & npm --prefix client run dev'",
    "dev:frontend": "npm --prefix client run dev",
    "dev:backend": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "server": "npm --prefix server start",
    "desktop-agent": "npm --prefix server run desktop-agent"
  }
}
